<!doctype html>
<html lang="en-CA">
  <head>
    {% set metaTitle = title or site.name %}
    {% set metaDescription = description or summary or site.description %}
    {% set canonicalUrl = canonical_url or site.url + page.url %}
    {% set metaImage = (featured_image or "/assets/vault-social-v2.jpg") | absoluteUrl(site.url) %}
    {% set metaImageAlt = featured_image_alt or (metaTitle if featured_image else "The Vault: essays and field notes by James Burchill, with a rampant lion") %}
    {% set isArticle = page.inputPath | isVaultArticle %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#263d31">
    <title>{% if page.url == "/" %}{{ metaTitle }}{% else %}{% if metaTitle and metaTitle != site.name %}{{ metaTitle }} | {% endif %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <link rel="icon" href="/assets/vault-favicon.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/assets/vault-favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="alternate" href="/feeds/rss.xml" type="application/rss+xml" title="{{ site.name }}">
    <link rel="alternate" href="/feeds/vault.json" type="application/feed+json" title="{{ site.name }}">
    <link rel="describedby" type="application/ld+json" href="/.well-known/provenance.json">
    {% if isArticle %}
    <link rel="describedby" type="application/ld+json" href="./provenance.jsonld">
    {% endif %}
    <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ metaImage }}">
    <meta property="og:image:alt" content="{{ metaImageAlt }}">
    {% if not featured_image %}
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% endif %}
    <meta property="og:site_name" content="{{ site.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ metaImage }}">
    <meta name="twitter:image:alt" content="{{ metaImageAlt }}">
    {% if isArticle and date %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    {% endif %}
    {% if isArticle and (updated or modified) %}
    <meta property="article:modified_time" content="{{ (updated or modified) | isoDate }}">
    {% endif %}
    {% if isArticle %}
    {% for topic in topics or [] %}
    <meta property="article:tag" content="{{ topic }}">
    {% endfor %}
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Article", "BlogPosting"],
  "headline": {{ metaTitle | json | safe }},
  "description": {{ metaDescription | json | safe }},
  "url": {{ canonicalUrl | json | safe }},
  "mainEntityOfPage": {{ canonicalUrl | json | safe }},
  "image": {{ metaImage | json | safe }},
  "author": {
    "@type": "Person",
    "name": "James Burchill",
    "url": "https://jamesburchill.com/"
  },
  "publisher": {
    "@type": "Person",
    "name": "James Burchill",
    "url": "https://jamesburchill.com/"
  }{% if date %},
  "datePublished": {{ date | isoDate | json | safe }}{% endif %}{% if updated or modified %},
  "dateModified": {{ (updated or modified) | isoDate | json | safe }}{% endif %}{% if original_url %},
  "isBasedOn": {{ original_url | json | safe }}{% endif %}
}
    </script>
    {% endif %}
    <link rel="stylesheet" href="{{ stylesheetUrl }}">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/assets/white-lion.png" alt="" width="52" height="52">
        <span>{{ site.name }}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/reading-paths/">Start Here</a>
        <a href="https://becausedrifthappens.com/">Because Drift Happens</a>
        <a href="/content/">Writing</a>
        <a href="/search/">Search</a>
        <a href="/about/">About the Vault</a>
        <a href="https://jamesburchill.com/">James Burchill</a>
      </nav>
    </header>

    <main class="page-shell">
      <article class="content{% if isArticle %} vault-article{% endif %}">
        {% if isArticle %}
        {% set articleMeta %}{% include "article-meta.njk" %}{% endset %}
        {{ content | withArticleMeta(articleMeta) | safe }}
        {% set nextReads = collections.vaultContent | nextReads(page.url) %}
        {% if nextReads.length %}
        <section class="next-reads" aria-label="Read next">
          <h2>Read Next</h2>
          <ul>{% for next in nextReads %}<li><a href="{{ next.item.url }}">{{ next.item.data.title }}</a>{% if next.reason or next.item.data.summary %}<p>{{ next.reason or next.item.data.summary }}</p>{% endif %}</li>{% endfor %}</ul>
        </section>
        {% endif %}
        {% include "follow.njk" %}
        {% else %}{{ content | safe }}{% endif %}
        {% if page.inputPath | isVaultArticle %}
        <p class="source-link">
          <a href="{{ page.inputPath | sourceUrl(site.repository) }}">View source Markdown</a>
          ·
          <a href="./provenance.jsonld">Verified Provenance</a>
        </p>
        {% endif %}
      </article>
    </main>

    <footer class="site-footer">
      <span>Copyright {{ site.copyrightYear }} ~ <a href="https://jamesburchill.com/">James Burchill</a></span>
      <span>Markdown source is canonical.</span>
      <a href="https://jamesburchill.com/mcp/">Connect your AI assistant</a>
      <a href="/books-resources/">Books &amp; Resources</a>
      <a href="/llms.txt">llms.txt</a>
      <a href="/search-index.json">Search index</a>
      <a href="/feeds/vault.json">JSON feed</a>
      <a href="/feeds/rss.xml">RSS</a>
      <a href="/sitemap.xml">Sitemap</a>
      <a href="/.well-known/provenance.json">Provenance</a>
    </footer>
    <script>
      (() => {
        document.querySelectorAll("[data-archive-browser]").forEach((archive) => {
          const years = archive.querySelectorAll("[data-archive-year]");
          const panels = archive.querySelectorAll("[data-archive-panel]");

          years.forEach((year) => {
            year.addEventListener("click", () => {
              const selectedYear = year.dataset.archiveYear;

              years.forEach((candidate) => {
                candidate.classList.toggle("is-current", candidate === year);
              });

              panels.forEach((panel) => {
                const isSelected = panel.dataset.archivePanel === selectedYear;
                panel.hidden = !isSelected;
                panel.classList.toggle("is-current", isSelected);
              });
            });
          });
        });
      })();
    </script>
  </body>
</html>

---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/content/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/reading-paths/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/governing-intelligent-systems/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/because-drift-happens/</loc>
  </url>
  <url><loc>{{ site.url }}/books-resources/</loc></url>
{%- for subject in subjects %}
  <url><loc>{{ site.url }}/subjects/{{ subject.id }}/</loc></url>
{%- endfor %}
{%- for item in collections.vaultContent %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {% if item.data.updated or item.data.modified %}
    <lastmod>{{ (item.data.updated or item.data.modified) | dateOnly }}</lastmod>
    {% endif %}
  </url>
{%- endfor %}
{%- for year in collections.vaultYears %}
  <url>
    <loc>{{ site.url }}{{ year.url }}</loc>
  </url>
{%- endfor %}
{%- for month in collections.vaultMonths %}
  <url>
    <loc>{{ site.url }}{{ month.url }}</loc>
  </url>
{%- endfor %}
</urlset>
